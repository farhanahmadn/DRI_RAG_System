GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Hardening (Fase 3.3) — semua opsional, punya default masuk akal kalau tidak diisi.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
REASONING_MAX_WORKERS=8
RATE_LIMIT_PER_MENIT=10

# Observability opsional (Langfuse self-host) — kosongkan utk nonaktifkan (no-op total).
# Butuh `pip install -e ".[observability]"` supaya library langfuse terpasang.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- RAG / retrieval (tim RAG) ---
# Postgres+pgvector lokal (docker-compose.yml). Ganti host/kredensial bila pakai Supabase/instance lain.
DATABASE_URL=postgresql://rdtr:rdtr@localhost:5432/rdtr
# Pilihan retriever backend API: "asli" (default, butuh DB+psycopg terpasang) atau "mock" (tanpa DB).
# Test offline SELALU override ke mock (tests/conftest.py), env ini cuma dipakai jalur app sungguhan.
RETRIEVER=asli
RETRIEVER_WILAYAH="Sleman Tengah"

# Provider embedding & rerank — "jina" (default produksi sejak Tahap 5, lihat docs/STATUS_RAG.md
# § Keputusan provider embedding/rerank utk alasan lengkap) atau "local" (bge-m3/bge-reranker-v2-m3
# via transformers, jalan di mesin sendiri — dipertahankan sbg jalur rollback). Ganti provider =
# override env ini di .env lokal Anda, TIDAK ubah kode (pola sama seperti LLM_BASE_URL/LLM_MODEL di
# llm_client.py). Dimensi vektor sama (1024) di keduanya sehingga bisa hidup berdampingan di kolom
# `chunks.embedding`/`chunk_embeddings_ab` yang sama (ditandai `embedding_provider`).
EMBEDDING_PROVIDER=jina
RERANK_PROVIDER=jina
EMBEDDING_DIM=1024

# Provider "local" — WAJIB model sama antara ingest (chunk) dan query.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Provider "jina" (https://jina.ai) — butuh JINA_API_KEY.
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v3

# Hardening panggilan provider embedding/rerank eksternal (jina) — opsional, pola sama
# seperti LLM_TIMEOUT_S/LLM_MAX_RETRIES. Tidak dipakai provider "local" (tak ada panggilan network).
EMBED_TIMEOUT_S=30
EMBED_MAX_RETRIES=2
RERANK_TIMEOUT_S=30
RERANK_MAX_RETRIES=2
# Circuit breaker: buka setelah N kegagalan beruntun (gagal cepat, bukan nunggu timeout tiap kali),
# coba lagi (half-open) setelah cooldown. Dipisah per provider+operasi (mis. "jina-embed").
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_COOLDOWN_S=30
# Batas panggilan Jina in-flight BERSAMAAN (semaphore, lintas embed+rerank) — TERPISAH dari
# REASONING_MAX_WORKERS (itu paralelisme thread reasoning umum; ini murni network call ke Jina).
# Panggilan ke-N+1 antre, bukan gagal. Naikkan kalau tier Jina Anda mendukung concurrency lebih tinggi.
PROVIDER_MAX_CONCURRENT=2

# Cache in-memory hasil retrieval+rerank final, dikunci (kategori, zona, dokumen, +provider aktif) —
# memangkas panggilan API embed/rerank eksternal berulang utk query yang repetitif antar-permohonan.
# Per-proses (in-memory), reset saat restart. RETRIEVAL_CACHE_ENABLED=false utk matikan (mis. debug).
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_S=3600
RETRIEVAL_CACHE_MAX_ENTRIES=2000

# Parser (Langkah 3) — isi kalau memakai LlamaParse:
# LLAMA_CLOUD_API_KEY=
