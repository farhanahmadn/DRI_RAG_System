GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Hardening (Fase 3.3) — semua opsional, punya default masuk akal kalau tidak diisi.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
REASONING_MAX_WORKERS=8
RATE_LIMIT_PER_MENIT=10

# Observability opsional (Langfuse self-host) — kosongkan utk nonaktifkan (no-op total).
# Butuh `pip install -e ".[observability]"` supaya library langfuse terpasang.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- RAG / retrieval (tim RAG) ---
# Postgres+pgvector lokal (docker-compose.yml). Ganti host/kredensial bila pakai Supabase/instance lain.
DATABASE_URL=postgresql://rdtr:rdtr@localhost:5432/rdtr
# Pilihan retriever backend API: "asli" (default, butuh DB+psycopg terpasang) atau "mock" (tanpa DB).
# Test offline SELALU override ke mock (tests/conftest.py), env ini cuma dipakai jalur app sungguhan.
RETRIEVER=asli
RETRIEVER_WILAYAH="Sleman Tengah"
# Model embedding & reranker — WAJIB sama antara ingest (chunk) dan query.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Parser (Langkah 3) — isi kalau memakai LlamaParse:
# LLAMA_CLOUD_API_KEY=
